{
  "name": "@blockchainian/codex-client",
  "version": "0.2.1",
  "description": "A typed HTTP/2 Codex Responses client backed by a ChatGPT file login.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blockchainian/codex-client.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "lint": "eslint src tests --max-warnings=0",
    "format:check": "prettier --check src tests package.json tsconfig.json tsconfig.build.json README.md"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "65.4.5",
    "eslint-plugin-unicorn": "62.0.0",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "openai": "^7.55.0",
    "@types/ws": "^8.18.2"
  }
}
